# Connection Mode: "usb" or "wifi"
CONNECTION_MODE=wifi

# USB Serial settings (used when CONNECTION_MODE=usb)
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD=9600

# ESP32 WiFi bridge settings (used when CONNECTION_MODE=wifi)
ESP32_BRIDGE_IP=10.86.205.93
ESP32_BRIDGE_PORT=8888

# Dashboard settings
DASHBOARD_HOST=0.0.0.0
PORT=5000

# Hack Club AI Key
HACKCLUB_AI_KEY=your_hackclub_ai_key_here
